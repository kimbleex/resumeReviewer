generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  role         UserRole   @default(MEMBER)
  status       UserStatus @default(ACTIVE)
  sessions     Session[]
  reviewRuns   ReviewRun[]
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
}

model Session {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String        @unique
  status           SessionStatus @default(ACTIVE)
  userAgentHash    String?
  ipHash           String?
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime      @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([status])
}

model GuestIdentity {
  id              String      @id @default(cuid())
  fingerprintHash String      @unique
  publicKeyHash   String?     @unique
  status          GuestStatus @default(ACTIVE)
  trialUsedCount  Int         @default(0)
  maxTrialCount   Int         @default(1)
  reviewRuns      ReviewRun[]
  firstSeenAt     DateTime    @default(now())
  lastSeenAt      DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
}

model ReviewRun {
  id           String          @id @default(cuid())
  userId       String?
  guestId      String?
  user         User?           @relation(fields: [userId], references: [id])
  guest        GuestIdentity?  @relation(fields: [guestId], references: [id])
  actorType    ActorType
  status       ReviewRunStatus @default(STARTED)
  targetRole   String
  errorMessage String?
  startedAt    DateTime        @default(now())
  completedAt  DateTime?

  @@index([actorType])
  @@index([startedAt])
  @@index([userId])
  @@index([guestId])
}

enum UserRole {
  ADMIN
  MEMBER
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum GuestStatus {
  ACTIVE
  BLOCKED
}

enum ActorType {
  USER
  GUEST
}

enum ReviewRunStatus {
  STARTED
  COMPLETED
  FAILED
}
